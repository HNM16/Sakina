{
  "name": "sakina",
  "version": "0.0.1",
  "private": true,
  "description": "Sakina — a messenger for Tajikistan, built to become a super-app.",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./services/* build",
    "typecheck": "pnpm -r --filter=./packages/* --filter=./services/* typecheck",
    "dev": "pnpm --parallel --filter=@sakina/api --filter=@sakina/gateway dev",
    "db:generate": "pnpm --filter=@sakina/db generate",
    "db:migrate": "pnpm --filter=@sakina/db migrate",
    "db:seed": "pnpm --filter=@sakina/db seed",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/docker-compose.yml down -v"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  }
}
