{
  "name": "sakina",
  "version": "0.0.1",
  "private": true,
  "description": "Sakina \u2014 a messenger for Tajikistan, built to become a super-app.",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./services/* build",
    "typecheck": "pnpm -r --filter=./packages/* --filter=./services/* typecheck",
    "dev": "pnpm --parallel --filter=@sakina/api --filter=@sakina/gateway --filter=@sakina/worker dev",
    "db:generate": "pnpm --filter=@sakina/db generate",
    "db:migrate": "pnpm --filter=@sakina/db migrate",
    "db:seed": "pnpm --filter=@sakina/db seed",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/docker-compose.yml down -v",
    "dev:client": "node tools/dev-client/serve.mjs",
    "brand:render": "node tools/brand-render.mjs",
    "test": "pnpm test:auth && pnpm test:bans && pnpm test:messaging && pnpm test:push && pnpm test:social && pnpm test:l10n && pnpm test:dart && pnpm test:motion",
    "test:messaging": "node services/gateway/scripts/e2e-smoke.mjs",
    "test:auth": "node services/api/scripts/auth-smoke.mjs",
    "test:bans": "pnpm --filter=@sakina/api exec tsx scripts/ban-smoke.ts",
    "test:social": "node services/api/scripts/social-smoke.mjs",
    "test:l10n": "node apps/mobile/scripts/l10n-check.mjs",
    "test:dart": "node apps/mobile/scripts/dart-sanity.mjs",
    "test:motion": "node tools/motion-check.mjs",
    "test:browser": "node tools/dev-client/verify.mjs",
    "test:devices": "node tools/device-matrix/verify.mjs",
    "test:push": "node services/worker/scripts/push-smoke.mjs",
    "bench": "pnpm bench:throughput && pnpm bench:fps",
    "bench:throughput": "node services/gateway/scripts/bench-throughput.mjs",
    "bench:fps": "node tools/dev-client/bench-fps.mjs"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "ws": "^8.21.2"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  }
}
