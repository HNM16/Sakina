NODE_ENV=development

DATABASE_URL=postgres://sakina:sakina@localhost:5432/sakina
REDIS_URL=redis://localhost:6379

API_PORT=4000
GATEWAY_PORT=4001

# Generate real values for anything past local dev:  openssl rand -base64 32
JWT_SECRET=dev-only-secret-change-me-please
OTP_PEPPER=dev-only-pepper-change-me-please

# ---------------------------------------------------------------------------
# Signing in without SMS
# ---------------------------------------------------------------------------
# Three independent routes, in order of how permanent they are.

# 1. Dev mode. Returns the verification code in the HTTP response instead of
#    delivering it. The API refuses to boot with this on when NODE_ENV=production.
OTP_DEV_MODE=true

# 2. Reserved identities. Fixed value:code pairs that skip delivery in EVERY
#    environment, production included. Not a shortcut to strip before launch —
#    App Store and Play reviewers cannot receive a Tajik SMS, and an account
#    they cannot sign into gets the app rejected. The code is still verified.
TEST_IDENTITIES=qa@sakina.tj:000000

# 3. A real provider. Email is what works from outside Tajikistan today.
EMAIL_PROVIDER=console          # console | resend | http
# RESEND_API_KEY=
EMAIL_FROM=Sakina <no-reply@sakina.tj>

# SMS stays configured for launch in Tajikistan. Telegram's Gateway is ~$0.01
# per code against ~$0.05-0.10 for international SMS to +992, works from
# anywhere with no operator contract, and is free to your own number.
SMS_PROVIDER=stub               # stub | telegram | http
# TELEGRAM_GATEWAY_TOKEN=
# SMS_HTTP_URL=                 # Tcell / Megafon / Babilon gateway at launch

# ---------------------------------------------------------------------------
# Duplicate accounts
# ---------------------------------------------------------------------------
# Email is a weak identity: one mailbox can be written many ways. Address
# canonicalisation (packages/core/src/identity.ts) removes the free duplicate;
# these limit the cost of the rest. See docs/ANTI-ABUSE.md.

MAX_SIGNUPS_PER_DEVICE=3
MAX_SIGNUPS_PER_IP=20
SIGNUP_WINDOW_HOURS=24
OTP_RESEND_COOLDOWN_SECONDS=60

# Invite-only is the strongest lever available, and doubles as the growth loop.
REQUIRE_INVITE=false
INVITES_PER_USER=5

# Extra throwaway domains, on top of the built-in list.
# DISPOSABLE_EMAIL_DOMAINS=
# Restrict registration entirely, e.g. for a single-university pilot.
# ALLOWED_EMAIL_DOMAINS=

# ---------------------------------------------------------------------------
# Push notifications
# ---------------------------------------------------------------------------
# The only way to reach a closed app — the socket is dead once the OS suspends
# it. `console` records pushes instead of sending them, which is what makes the
# path testable with no Firebase project and no handset.

PUSH_PROVIDER=console           # console | real
PUSH_DEV_INSPECT=true           # exposes /dev/pushes on the worker; refused in production
WORKER_PORT=4003

# FCM (Android, and iOS via APNs forwarding). The legacy server-key API was shut
# down in 2024, so this is a service account and nothing else.
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=

# APNs direct, if you ever want to bypass FCM on iOS. Token auth with a .p8 key.
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_PRIVATE_KEY=
# APNS_BUNDLE_ID=tj.sakina.app
# APNS_ENVIRONMENT=sandbox
