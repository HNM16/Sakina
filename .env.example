NODE_ENV=development

DATABASE_URL=postgres://sakina:sakina@localhost:5432/sakina
REDIS_URL=redis://localhost:6379

API_PORT=4000
GATEWAY_PORT=4001

# Generate real values for anything past local dev:  openssl rand -base64 32
JWT_SECRET=dev-only-secret-change-me-please
OTP_PEPPER=dev-only-pepper-change-me-please

# Returns the OTP in the HTTP response instead of sending an SMS.
# The API refuses to boot with this on when NODE_ENV=production.
OTP_DEV_MODE=true
